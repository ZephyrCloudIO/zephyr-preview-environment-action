{
  "name": "zephyr-preview-environments-action",
  "version": "1.0.0",
  "description": "Create preview environments using Zephyr (PR-only action)",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --minify --outfile=index.js",
    "build:examples": "cd zephyr-examples/jarvis && pnpm i && pnpm run build && cd ../hal && pnpm i && pnpm run build",
    "prepare": "husky",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs"
  },
  "keywords": [],
  "author": "ZephyrCloudIO",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "node-persist": "^4.0.4",
    "zephyr-agent": "^0.1.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.12.2",
    "@types/node-persist": "3.1.8",
    "esbuild": "0.27.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "typescript": "5.9.3",
    "ultracite": "7.1.1"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.1",
      "form-data": "4.0.6",
      "axios": "1.18.0",
      "undici": "6.28.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "@babel/core": "7.29.6",
      "@eslint/plugin-kit": "^0.7.0",
      "adm-zip": "0.6.0",
      "brace-expansion": "5.0.8",
      "koa": "3.1.2",
      "picomatch": "^4.0.4",
      "postcss": "8.5.23",
      "yaml": "2.8.3",
      "follow-redirects@<1.16.0": ">=1.16.0",
      "ws@>=8.0.0 <8.21.0": "8.21.3"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm exec ultracite fix"
    ]
  }
}
